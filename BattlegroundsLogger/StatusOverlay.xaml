<UserControl x:Class="BattlegroundsLogger.StatusOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="200" Height="30">
    <Border Name="StatusBorder" 
            Background="#CC000000" 
            CornerRadius="5" 
            BorderBrush="#FF00FF00" 
            BorderThickness="1"
            Opacity="0.8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Ellipse Name="StatusLight" 
                     Grid.Column="0" 
                     Width="6" 
                     Height="6" 
                     Fill="LimeGreen" 
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Center"/>
            
            <TextBlock Name="StatusText" 
                       Grid.Column="1" 
                       Text="BG Logger: Ready" 
                       Foreground="White" 
                       FontSize="11" 
                       VerticalAlignment="Center" 
                       Margin="5,0"/>
            
            <TextBlock Name="TurnCounter" 
                       Grid.Column="2" 
                       Text="Turn: 0" 
                       Foreground="LightGray" 
                       FontSize="10" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0"/>
        </Grid>
    </Border>
</UserControl>