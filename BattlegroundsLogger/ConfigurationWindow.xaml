<Window x:Class="BattlegroundsLogger.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battlegrounds Logger Configuration" Height="300" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Battlegrounds Logger Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <Label Grid.Row="1" Content="Output Directory:"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="OutputDirectoryTextBox" Grid.Column="0" Margin="0,0,5,0"/>
            <Button Name="BrowseButton" Grid.Column="1" Content="Browse..." Width="75" Click="BrowseButton_Click"/>
        </Grid>
        
        <CheckBox Grid.Row="3" Name="EnableLoggingCheckBox" Content="Enable Logging" Margin="0,5"/>
        <CheckBox Grid.Row="4" Name="VerboseLoggingCheckBox" Content="Verbose Logging" Margin="0,5"/>
        
        <Label Grid.Row="5" Content="Max Sessions to Keep (0 = unlimited):"/>
        <TextBox Grid.Row="6" Name="MaxSessionsTextBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="SaveButton" Content="Save" Width="75" Margin="5" Click="SaveButton_Click"/>
            <Button Name="CancelButton" Content="Cancel" Width="75" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>